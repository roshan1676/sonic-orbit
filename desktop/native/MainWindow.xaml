<Window x:Class="SonicOrbit.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="SonicOrbit Native" Width="1180" Height="800" MinWidth="920" MinHeight="650" Background="#11180F" Foreground="#E8EDE3" FontFamily="Segoe UI" AllowDrop="True" Drop="MediaDrop">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="SONICORBIT" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="NATIVE PLAYER · OFFLINE SPATIAL AUDIO" Foreground="#9AA991" FontSize="10" Margin="0,5,0,0"/></StackPanel><Button Content="Open music or video" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="OpenClick"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,24,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#070A06" BorderBrush="#36432C" BorderThickness="1"><vlc:VideoView x:Name="Video"><Grid x:Name="EmptyCover" Background="#070A06"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="SONICORBIT" FontSize="30" Foreground="#C2DDA8" HorizontalAlignment="Center"/><TextBlock Text="Open a local scene. Make it yours." Foreground="#8E9E83" Margin="0,16,0,0"/></StackPanel></Grid></vlc:VideoView></Border>
        <StackPanel Grid.Row="1" Margin="0,14,0,0"><TextBlock x:Name="FileLabel" Text="Drop a local video or song here." TextTrimming="CharacterEllipsis"/><Slider x:Name="Seek" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="SeekBegin" PreviewMouseLeftButtonUp="SeekEnd"/><DockPanel><StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="Play" Click="PlayClick"/><Button Content="Stop" Click="StopClick"/></StackPanel><TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></StackPanel>
        <Border Grid.Row="2" Background="#1C2617" Padding="14" Margin="0,20,0,0"><StackPanel><TextBlock x:Name="Status" Text="Ready. No browser or model download is needed for spatial playback." TextWrapping="Wrap" LineHeight="20"/><TextBlock x:Name="AiStatus" Text="Checking the bundled AI pack…" TextWrapping="Wrap" Foreground="#A7B69B" Margin="0,8,0,0"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Your listening stage" FontSize="23" Margin="0,0,0,15"/><CheckBox x:Name="Spatial" Content="Spatial headphone rendering" IsChecked="True" Foreground="#E8EDE3" Checked="SoundChanged" Unchecked="SoundChanged"/>
        <TextBlock Text="Measured headphone profile" Margin="0,20,0,0"/><ComboBox x:Name="Profile" SelectionChanged="ProfileChanged" SelectedIndex="0"><ComboBoxItem Content="SADIE II · H3" Tag="H3"/><ComboBoxItem Content="SADIE II · H17" Tag="H17"/></ComboBox>
        <TextBlock Text="Listening volume"/><Slider x:Name="Volume" Minimum="0" Maximum="100" Value="40" ValueChanged="SoundChanged" AutomationProperties.Name="Listening volume"/>
        <TextBlock Text="Stage width"/><Slider x:Name="StageWidth" Minimum="10" Maximum="85" Value="45" ValueChanged="SoundChanged" AutomationProperties.Name="Stage width"/>
        <TextBlock Text="Head turn preview · not a sensor"/><Slider x:Name="Yaw" Minimum="-180" Maximum="180" Value="0" ValueChanged="SoundChanged" AutomationProperties.Name="Head turn preview"/>
        <CheckBox x:Name="ExternalTracking" Content="Use OpenTrack orientation" Foreground="#E8EDE3" Checked="TrackingChanged" Unchecked="TrackingChanged"/>
        <Button Content="Recenter tracking" Click="RecenterClick" Margin="0,10,8,8"/><TextBlock x:Name="TrackingStatus" Text="Optional tracker · loopback UDP 4243 · yaw only" Foreground="#9AA991" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,20"/>
        <TextBlock Text="Audio output"/><ComboBox x:Name="Devices" SelectionChanged="DeviceChanged" DisplayMemberPath="Name"/><Button Content="Refresh connected outputs" Click="RefreshDevices"/>
        <TextBlock Text="Video lip-sync adjustment (ms)" Margin="0,20,0,0"/><Slider x:Name="LipSync" Minimum="-200" Maximum="300" Value="0" ValueChanged="LipSyncChanged" AutomationProperties.Name="Lip sync milliseconds"/>
        <TextBlock Text="Bluetooth outputs work as Windows audio devices. Connection alone supplies no head pose." Foreground="#9AA991" TextWrapping="Wrap" FontSize="11" LineHeight="18"/>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="1">
        <Separator Margin="0,16,0,14"/><Button x:Name="PrepareAI" Content="Prepare local AI tracks" Click="PrepareClick"/><Button x:Name="CancelAI" Content="Cancel processing" Click="CancelClick" IsEnabled="False" Margin="0,10,8,0"/>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="5" Margin="0,14,0,14"/>
        <CheckBox x:Name="AiScene" Content="Use prepared AI front stage" Foreground="#E8EDE3" IsEnabled="False" Checked="AiSceneChanged" Unchecked="AiSceneChanged"/>
        <TextBlock Text="Music separation can leave artifacts. Generic ear profiles need listening comparison. This is an alpha, with no Atmos decoder or live head sensor." TextWrapping="Wrap" Foreground="#9AA991" FontSize="11" LineHeight="18" Margin="0,20,0,0"/>
      </StackPanel></Grid>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="Diagnostics" Text="SonicOrbit Native 0.2.0-alpha.1 · 48 kHz stereo · shared peak headroom" Foreground="#8E9E83" FontSize="10" Margin="0,22,0,0"/>
  </Grid>
</Window>
